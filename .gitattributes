# Normalize line endings in the repository:
# - store LF in git
# - keep working tree consistent across OSes
* text=auto eol=lf

# Explicitly normalize common project files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env  text eol=lf

# Keep binaries as-is
*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.webp -text
*.ico  -text
*.svg  -text
*.pdf  -text

